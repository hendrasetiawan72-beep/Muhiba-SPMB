# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloudflare Turnstile CAPTCHA (Public Site Key)
VITE_TURNSTILE_SITE_KEY="0x4AAAAAA..."

# Cloudflare Turnstile Secret Key (Server ONLY)
TURNSTILE_SECRET_KEY="0x4AAAAAA..."

# Rate Limiting & Security (Server ONLY)
RATE_LIMIT_SALT="your-random-rate-limit-salt-string"
ALLOWED_ORIGIN="https://spmb.smkmuhiba.sch.id"
# Daftar origin yang diizinkan (pisahkan koma). WAJIB persis (https://host), tanpa wildcard.
# Hostname dari daftar ini juga dipakai untuk memverifikasi hostname token Turnstile.
# ALLOWED_ORIGINS="https://spmb.smkmuhiba.sch.id,https://muhiba-spmb.penadah1boom.workers.dev"

# (Opsional, Server ONLY) Kunci enkripsi rahasia sekali-tampil (password sementara reset).
# Jika kosong, diturunkan dari SUPABASE_SERVICE_ROLE_KEY. Minimal 32 karakter acak.
# RESET_SECRET_KEY="isi-dengan-string-acak-minimal-32-karakter"

# (Opsional, Server ONLY) Setelah frontend terbaru ter-deploy, set "true" agar token Turnstile
# TANPA action (mis. token dari klien lama) ditolak. Default longgar demi kompatibilitas cache klien.
# TURNSTILE_REQUIRE_ACTION="true"

# ==============================================================================
# SUPABASE CONFIGURATION (Frontend Client - Public Variables)
# ==============================================================================
# URL Project Supabase Anda (misal: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anon / Publishable Public Key (Aman untuk frontend / browser client)
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# ==============================================================================
# SUPABASE CONFIGURATION (Backend / Server-Side / Edge Function ONLY)
# JANGAN PERNAH menambahkan prefix VITE_ pada SERVICE_ROLE_KEY!
# Kunci ini hanya dibaca oleh server (server.ts / Edge Functions) untuk provisioning user.
# ==============================================================================
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
